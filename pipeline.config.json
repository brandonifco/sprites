{
  "codex": {
    "method": "cli",
    "cli_command": "npx @openai/codex exec",
    "sandbox": "workspace-write",
    "notes": "Uses ~/.codex/config.toml settings (gpt-5.6-luna, medium effort). Authenticates via ChatGPT Pro session — no API key needed."
  },
  "pipeline": {
    "config_path": "art/sprite-palettes/resurrect64_sprite_profiles.json",
    "specs_dir": "art/asset-specs",
    "staging_raw_dir": "staging/raw",
    "staging_normalized_dir": "staging/normalized",
    "assets_dir": "assets/sprites",
    "default_frames": ["idle"],
    "skip_existing": true,
    "max_generation_attempts": 3
  }
}
